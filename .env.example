# Explicit native test build: copy to .env.local, then npm run build && npx cap sync.
# This true value uses ONLY official Google sample unit IDs, including Vite production builds.
# For a public release set false, supply real IDs below, and replace native sample app IDs.
# Without this flag or real production IDs, production builds keep ads off.
VITE_ADMOB_TESTING=true
# Native production ad unit IDs only. Leave blank to keep ads off.
# Development always uses official Google test ad units; never put live IDs in dev builds.
VITE_ADMOB_IOS_BANNER=
VITE_ADMOB_IOS_INTERSTITIAL=
VITE_ADMOB_IOS_REWARDED=
VITE_ADMOB_ANDROID_BANNER=
VITE_ADMOB_ANDROID_INTERSTITIAL=
VITE_ADMOB_ANDROID_REWARDED=
# Native application IDs (~ delimiter) live in Info.plist and Android resources, not here.
# See docs/ADMOB.md. No account credentials belong in client code.
