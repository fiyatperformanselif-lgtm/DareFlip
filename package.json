{
  "name": "dareflip",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc -b && vite build && node scripts/offline.mjs",
    "preview": "vite preview --host 0.0.0.0",
    "typecheck": "tsc -b",
    "lint": "eslint .",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "native:sync": "npm run build && cap sync",
    "native:android": "cap open android",
    "native:ios": "cap open ios",
    "assets": "node scripts/assets.mjs",
    "test:offline": "playwright test -c playwright.offline.config.ts",
    "check:release": "node scripts/check-release.mjs",
    "format": "prettier --write src tests scripts *.ts *.js *.json *.html",
    "test:a11y": "playwright test -c tests/accessibility/playwright.config.ts",
    "setup:android": "bash scripts/setup-android.sh",
    "build:android": "npm run native:sync && python3 scripts/android-build.py",
    "beta:ios": "node scripts/prepare-ios-beta.mjs"
  },
  "dependencies": {
    "@capacitor-community/admob": "8.4.2",
    "@capacitor/android": "8.6.2",
    "@capacitor/app": "8.1.2",
    "@capacitor/core": "8.6.2",
    "@capacitor/filesystem": "8.1.5",
    "@capacitor/haptics": "8.0.2",
    "@capacitor/ios": "8.6.2",
    "@capacitor/share": "8.0.3",
    "lucide-react": "1.79.0",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.1",
    "@capacitor/assets": "4.0.0",
    "@capacitor/cli": "8.6.2",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.65.1",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.3.0",
    "eslint": "10.15.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.8",
    "prettier": "3.10.1",
    "sharp": "0.35.5",
    "typescript": "6.0.3",
    "typescript-eslint": "8.74.0",
    "vite": "8.3.8",
    "vitest": "5.1.1"
  },
  "engines": {
    "node": ">=24.0.0 <25"
  }
}
